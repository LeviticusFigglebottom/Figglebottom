[layer_names]

3d_physics/layer_1="world_base"
3d_physics/layer_2="world_thaw"
3d_physics/layer_3="world_rime"
3d_physics/layer_4="player"
3d_physics/layer_5="enemy"
3d_physics/layer_6="hurtbox"
3d_physics/layer_7="interact"
3d_physics/layer_8="camera_clip"

[rendering]

lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=4
environment/defaults/default_clear_color=Color(0.04, 0.045, 0.06, 1)
anti_aliasing/quality/screen_space_aa=1

[shader_globals]

rh_wave_r={
"type": "float",
"value": -1000.0
}
rh_wave_origin={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
rh_wave_dir={
"type": "float",
"value": 1.0
}
rh_state_blend={
"type": "float",
"value": 0.0
}
rh_wave_band={
"type": "float",
"value": 4.0
}
rh_sky_top={
"type": "color",
"value": Color(0.35, 0.45, 0.6, 1)
}
rh_sky_horizon={
"type": "color",
"value": Color(0.7, 0.72, 0.74, 1)
}
rh_water_sky_fill={
"type": "float",
"value": 0.0
}
rh_wave_color={
"type": "vec3",
"value": Vector3(1, 0.78, 0.42)
}
