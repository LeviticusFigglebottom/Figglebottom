; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Rimeholt"
config/use_custom_user_dir.template=true
config/custom_user_dir_name.template="Rimeholt"
config/description="A soulslike of the frozen highland: one remembered summer evening, and the winter that would not end."
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[audio]

buses/default_bus_layout="res://assets/audio/default_bus_layout.tres"

[autoload]

DB="*res://src/core/db.gd"
World="*res://src/core/world_state.gd"
Game="*res://src/core/game.gd"
StateDirector="*res://src/core/state_director.gd"
AudioDirector="*res://src/core/audio_director.gd"
Juice="*res://src/core/juice.gd"
PauseUI="*res://src/ui/pause_menu.gd"
Shot="*res://src/debug/shot.gd"

[debug]

gdscript/warnings/unused_parameter=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://assets/ui/rimeholt_theme.tres"

[importer_defaults]

texture={
"compress/mode": 2,
"detect_3d/compress_to": 0
}

