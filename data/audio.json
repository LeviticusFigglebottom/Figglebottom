{
	"_doc": "Non-state music, the rite, the state wave and foley sets. Per-state music/ambience and their crossfades live in state_profiles.json. Every stream listed under music/ambience is checked by the audio suite; 'loop' must match the stream's import flag. Generated by tools/audio/*.py (docs/audio/MUSIC.md).",
	"music": {
		"title": {"path": "res://assets/audio/music/theme_title.ogg", "loop": true, "fade": 1.2},
		"outsong": {"path": "res://assets/audio/music/outsong.ogg", "loop": false, "fade": 1.0, "then_world_after": 0.0},
		"boss_netmender": {"path": "res://assets/audio/music/boss_netmender.ogg", "loop": true, "fade": 1.5}
	},
	"boss_fallback": "boss_netmender",
	"hum": "res://assets/audio/hum.wav",
	"wave": {
		"to_rime": "res://assets/audio/wave_to_rime.ogg",
		"to_thaw": "res://assets/audio/wave_to_thaw.ogg",
		"music_out_fade": 2.5
	},
	"footsteps": {
		"variants": 4,
		"path": "res://assets/audio/foley/step_%s_%d.wav",
		"surfaces": ["turf", "shingle", "plank", "snow"],
		"shingle_splat": 0.45,
		"on_ground_tolerance": 0.45
	},
	"foley": {
		"frost_hit": ["res://assets/audio/foley/hit_frost_1.wav", "res://assets/audio/foley/hit_frost_2.wav", "res://assets/audio/foley/hit_frost_3.wav"],
		"frost_fall": "res://assets/audio/foley/frost_fall.wav",
		"coal_catch": "res://assets/audio/foley/coal_catch.wav"
	}
}
