	"ambience": {
		"_doc": "base_db is the level of a state's base bed (state_profiles.json 'ambience'); each region adds layers [file, dB relative to the base] per state, after docs/art/BIOMES.md. hearth and veil are positional loops hung on lit Hearthstones and frost veils.",
		"base_db": -9.0,
		"layer_path": "res://assets/audio/ambience/%s.ogg",
		"hearth": {
			"bed": "hearth_loop",
			"db": -4.0,
			"rime_db": -14.0
		},
		"veil": {
			"bed": "veil_loop",
			"db": -5.0
		},
		"regions": {
			"saltfell_steading": {
				"thaw": [
